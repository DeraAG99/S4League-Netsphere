	<string key="N2000076" kor="마르스 카운터 스워드" ger="Icicle Counter Sword" eng="Icicle Counter Sword" tur="Icicle Counter Sword" fre="Icicle Counter Sword" rus="Icicle Counter Sword" cns="圣诞角斗卫士"/>
	<string key="T2000076" kor="크리스마스에 문앞을 지켜주는 크리스마스 장식 리스를 본따 만든 카운터 스워드" ger="Dieses handgefertigte Counter Sword wurde einem Weihnachtskranz nachempfunden." eng="This custom counter sword is modeled after a Christmas wreath." tur="Bu özel kılıç bir Yılbaşı çelenginden esinlenilerek modellenmiş." fre="Cette épée est ornée d'une couronne de Noël." rus="Защита против меча в виде рождественского венка." cns="专门为圣诞节制作的特典角斗卫士，充满了圣诞气息的近战利器"/>
	<string key="N4035483" kor="G의 마르스 카운터 스워드 캡슐" ger="G's Icicle Counter Sword Capsule" eng="G's Icicle Counter Sword Capsule" tur="G's Icicle Counter Sword Capsule" fre="G's Icicle Counter Sword Capsule" rus="G's Icicle Counter Sword Capsule" cns="G的圣诞角斗卫士扭蛋"/>
	<string key="T4035483" kor="G의  마르스 카운터 스워드 캡슐{N}캡슐 아이템 사용 시 다음과 같은 아이템이 랜덤하게 지급됩니다." ger="Eine G's Icicle Counter Sword Capsule.{N}Diese Kapsel kann folgende Items enthalten:" eng="A G's Icicle Counter Sword Capsule{N}The capsule contains the following items at random:" tur="G's Icicle Counter Sword Capsule{N}Kapsül şu eşyalardan birini rastgele içerir:" fre="G's Icicle Counter Sword Capsule{N}Cette capsule donne aléatoirement certains des objets suivants :" rus="G's Icicle Counter Sword Capsule{N}Капсула содержит случайные предметы:" cns="G的圣诞角斗卫士扭蛋{N}使用扭蛋时，可随机获得下列道具"/>
	<string key="N4052366" kor="2016 크리스마스 이벤트 캡슐" ger="2016 Christmas Event Capsule" eng="2016 Christmas Event Capsule" tur="2016 Christmas Event Capsule" fre="2016 Christmas Event Capsule" spa="2016 Christmas Event Capsule" ita="2016 Christmas Event Capsule" rus="2016 Christmas Event Capsule" ame="2016 Christmas Event Capsule" cns="圣诞节活动扭蛋" tha="2016 Christmas Event Capsule" twn="聖誕活動膠囊" jap="クリスマスイベントカプセル" idn="2012 Christmas Event Capsule"/>
	<string key="T4052366" kor="산타가 남기고 간 선물! 어떤 선물이 들어있을까요? 두근두근!" ger="Ein Weihnachtsgeschenk für euch! Ratet mal, was drin ist!" eng="Christmas Present for you! Guess what is inside!" tur="İşte sana bir yılbaşı hediyesi! Bil bakalım içinde ne var!" fre="Voici un cadeau de Noël pour vous ! Devinez ce qu'il contient !" spa="Regalo de Navidad para ti! Adivina que hay dentro!" ita="Un dono di Natale! Indovina cosa contiene!" rus="Рождественский подарок! Угадай, что внутри!" cns="圣诞老人留下的神秘礼物！好好奇里面会装着什么呀~" tha="ของขวัญคริสต์มาสสำหรับคุณ มาทายกันดีกว่า ว่าอะไรอยู่ข้างใน" twn="聖誕老公公留下來的禮物！ 裡面裝有什麼禮物呢？好好奇喔！" jap="サンタが残してくれたプレゼント！どんなものが入っているでしょうか？わくわく…" idn="Hadiah Natal untukmu! Tebak apa yang ada di dalamnya!"/>
	<string key="N1021225" kor="윈터 스피릿 스케이트 슈트" ger="Winter Spirit Skate Suit" eng="Winter Spirit Skate Suit" tur="Winter Spirit Skate Suit" fre="Winter Spirit Skate Suit" rus="Winter Spirit Skate Suit" cns="雪之魂滑冰服"/>
	<string key="T1021225" kor="바람이건 총알이건 모두 비껴낸다는 윈터 스피릿의 스케이트 슈트" ger="Mit dieser Jacke macht man auf jeder Eisbahn eine gute Figur." eng="A jacket designed to rock the ice ring." tur="Buz pistini yıkacak bir ceket." fre="Un manteau pour enflammer votre look sur la piste de glace." rus="Куртка специально для катка." cns="即便是滑冰新手，穿上后也能做出弓身转这样的高难度动作"/>
	<string key="N1031225" kor="윈터 스피릿 스케이트 바지" ger="Winter Spirit Skate Pants" eng="Winter Spirit Skate Pants" tur="Winter Spirit Skate Pants" fre="Winter Spirit Skate Pants" rus="Winter Spirit Skate Pants" cns="雪之魂滑冰裤"/>
	<string key="T1031225" kor="진심 깔바지보다 더 따뜻하다는 윈터 스피릿의 스케이트 바지" ger="Diese Hosen halten sogar den eisigsten Frost ab." eng="These pants can keep you warm in the coldest winters." tur="Bu pantolon sizi kış soğuklarından koruyabilir." fre="Ce pantalon vous tiendra au chaud lors des hivers les plus rudes." rus="В таких штанах тепло будет даже самой холодной зимой." cns="即便是滑冰新手，穿上后也能做出弓身转这样的高难度动作"/>
	<string key="N1041225" kor="윈터 스피릿 장갑" ger="Winter Spirit Gloves" eng="Winter Spirit Gloves" tur="Winter Spirit Gloves" fre="Winter Spirit Gloves" rus="Winter Spirit Gloves" cns="雪之魂手套"/>
	<string key="T1041225" kor="{CB-255,255,0,255}[안전 제일]{N}{CB-255,255,255,255} 스케이트 장에서는 장갑을 꼭 착용합시다." ger="{CB-255,255,0,255}[Safety First]{N}{CB-255,255,255,255} Mit diesen Handschuhen sind eure Finger vor Angriffen bösartiger Kufen geschützt." eng="{CB-255,255,0,255}[Safety First]{N}{CB-255,255,255,255} These gloves will protect you from injuries on the ice ring." tur="{CB-255,255,0,255}[Önce Güvenlik]{N}{CB-255,255,255,255} Bu eldivenler sizi pistteki sakatlıklardan korur." fre="{CB-255,255,0,255}[Safety First]{N}{CB-255,255,255,255} Ces gloves vous protègeront du froid mordant sur la piste de glace." rus="{CB-255,255,0,255}[Главное – безопасность]{N}{CB-255,255,255,255} Перчатки защитят твои руки на катке." cns="{CB-255,255,0,255}赐予你【子弹时间】的能力！{N}{CB-255,255,255,255}开玩笑的啦~"/>
	<string key="N1051225" kor="윈터 스피릿 스케이트" ger="Winter Spirit Skates" eng="Winter Spirit Skates" tur="Winter Spirit Skates" fre="Winter Spirit Skates" rus="Winter Spirit Skates" cns="雪之魂滑冰靴"/>
	<string key="T1051225" kor="어떠한 조건에서도 스케이팅이 가능하게 제작된 특수 스케이트화" ger="Diese Schlittschuhe kommen mit jeder Eisfläche zurecht." eng="These special skates allow you to perform under any condition." tur="Bu özel patenler her durumda performansınızı büyüleyici kılar." fre="Ces patins à glaces vous permetteront de glisser sur la piste en toute circonstance." rus="Особые коньки отлично едут по любому льду." cns="即便是滑冰新手，穿上后也能做出弓身转这样的高难度动作"/>
	<string key="N1001225" kor="윈터 스피릿 컷" ger="Winter Spirit Haircut" eng="Winter Spirit Haircut" tur="Winter Spirit Haircut" fre="Winter Spirit Haircut" rus="Winter Spirit Haircut" cns="雪之魂发型"/>
	<string key="T1001225" kor="헤드 셋으로 멋을 낸 윈터 스피릿의 헤어 스타일" ger="Eine winterliche Frisur mit Headset." eng="Special haircut including headsets." tur="Kulaklıklı özel saç kesimi." fre="Une coupe spéciale incluant casque audio." rus="Особая прическа с наушниками." cns="即便是滑冰新手，穿上后也能做出弓身转这样的高难度动作"/>
	<string key="N1021226" kor="윈터 픽시 스케이트 슈트" ger="Winter Pixie Skate Suit" eng="Winter Pixie Skate Suit" tur="Winter Pixie Skate Suit" fre="Winter Pixie Skate Suit" rus="Winter Pixie Skate Suit" cns="雪精灵滑冰服"/>
	<string key="T1021226" kor="강추위뿐만 아니라 총알도 막아낸다는 겨울 요정의 스케이트 슈트" ger="Mit dieser Jacke macht man auf jeder Eisbahn eine gute Figur." eng="A jacket designed to rock the ice ring." tur="Buz pistini yıkacak bir ceket." fre="Un manteau pour enflammer votre look sur la piste de glace." rus="Куртка специально для катка." cns="穿上后可以像雪中的精灵一样翩翩起舞的雪精灵滑冰服"/>
