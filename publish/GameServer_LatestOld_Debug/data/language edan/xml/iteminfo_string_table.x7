	<string key="N4052208" kor="Blue Wave" eng="Blue Wave" rus="Blue Wave" cns="蓝色波纹"/>
	<string key="T4052208" kor="SEA 이벤트 아이템" eng="Calm waters, can change you to a great tsunami!" rus="Даже самая спокойная вода может вдруг стать цунами!" cns="海洋活动道具"/>
	<string key="N4052209" kor="Green Seaweed" eng="Green Seaweed" rus="Green Seaweed" cns="绿色海草"/>
	<string key="T4052209" kor="SEA 이벤트 아이템" eng="Contains nutrients that can enhance both you and your equipment!" rus="Содержат питательные вещества, которые могут усилить и вас, и ваше снаряжение!" cns="海洋活动道具"/>
	<string key="N4052210" kor="Purple Dawn" eng="Purple Dawn" rus="Purple Dawn" cns="紫色黎明"/>
	<string key="T4052210" kor="SEA 이벤트 아이템" eng="When the night is dark, you will be a star!" rus="Даже самой темной ночью ты будешь сиять!" cns="海洋活动道具"/>
	<string key="N4052211" kor="Violet Dusk" eng="Violet Dusk" rus="Violet Dusk" cns="紫罗兰色黄昏"/>
	<string key="T4052211" kor="SEA 이벤트 아이템" eng="Light up the morning, with your presence!" rus="Освети утро своим присутствием!" cns="海洋活动道具"/>
	<string key="N4052212" kor="Silver Stream" eng="Silver Stream" rus="Silver Stream" cns="银流"/>
	<string key="T4052212" kor="SEA 이벤트 아이템" eng="This box could not even contain the hotness of this summer set!" rus="Такой горячий набор, что даже коробка не спасает!" cns="海洋活动道具"/>
	<string key="N4052213" kor="Golden Sand" eng="Golden Sand" rus="Golden Sand" cns="金沙"/>
	<string key="T4052213" kor="SEA 이벤트 아이템" eng="Peel it and open up the best box of our summer event!" rus="Открой для себя лучшую коробку нашего летнего события!" cns="海洋活动道具"/>
	<string key="N4050378" kor="치파오 걸 복장 세트(내구제)" ger="Chinese Dress Set (permanent)" eng="Chinese Dress Set (Permanent)" tur="Chinese Dress Set (Permanent)" fre="Chinese Dress Set (Permanent)" spa="Chinese Dress Set (Permanent)" ita="Chinese Dress Set (Permanent)" rus="Chinese Dress Set (Бессрочн.)" cns="功夫少女套装（永久）" twn="少女功夫套裝(耐久制)"/>
	<string key="T4050378" kor="치파오 걸 복장 세트입니다.{N}세트 아이템 사용시 다음과 같은 아이템이 지급됩니다." ger="Chinese Dress Costume Set{N}Enthält folgende Items:" eng="Chinese dress Costume Set{N}includes following items" tur="Chinese dress Costume Set{N}includes following items" fre="Costume complet de la Robe Chinoise. {N}Contient les objets suivants" spa="Chinese Dress Costume Set. {N} Incluye los siguientes artículos:" ita="Chinese dress Costume Set. {N}Include i seguenti oggetti." rus="Набор китайских платьев{N}включает в себя предметы" cns="功夫少女套装{N}使用套装时，可随机获得下列道具" twn="少女功夫套裝。{N}使用套裝道具時，將可獲得如下的道具。"/>
