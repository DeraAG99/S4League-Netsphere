	<string key="N4060137" kor="오리엔탈 폭스 베이직세트(7/15/30/내구)" ger="Kitsune Fox Pen Set (7/15/30/Permanent)" eng="Kitsune Fox Pen Set (7/15/30/Permanent)" tur="Kitsune Fox Pen Set (7/15/30/Permanent)" fre="Kitsune Fox Pen Set (7/15/30/Permanent)" rus="Kitsune Fox Pen Set (7/15/30/бессрочн.)" cns="恶魔卫士（女）普通套装（7/15/30/永久）"/>
	<string key="N4060138" kor="치파오 걸 베이직세트(7/15/30/내구)" ger="Chipao Girl Pen Set (7/15/30/Permanent)" eng="Chipao Girl Pen Set (7/15/30/Permanent)" tur="Chipao Girl Pen Set (7/15/30/Permanent)" fre="Chipao Girl Pen Set (7/15/30/Permanent)" rus="Chipao Girl Pen Set (7/15/30/бессрочн.)" cns="功夫少女普通套装（7/15/30/永久）"/>
	<string key="N4060139" kor="마샬아츠 레이디 베이직세트(7/15/30/내구)" ger="Martial Arts Lady Pen Set (7/15/30/Permanent)" eng="Martial Arts Lady Pen Set (7/15/30/Permanent)" tur="Martial Arts Lady Pen Set (7/15/30/Permanent)" fre="Martial Arts Lady Pen Set (7/15/30/Permanent)" rus="Martial Arts Lady Pen Set (7/15/30/бессрочн.)" cns="武术少女普通套装（7/15/30/永久）"/>
	<string key="N4060140" kor="비올라 카타나(7/15/30/내구)" ger="Viola Katana(7/15/30/Permanent)" eng="Viola Katana(7/15/30/Permanent)" tur="Viola Katana(7/15/30/Permanent)" fre="Viola Katana(7/15/30/Permanent)" rus="Viola Katana (7/15/30/бессрочн.)" cns="紫罗兰太刀（7/15/30/永久）"/>
