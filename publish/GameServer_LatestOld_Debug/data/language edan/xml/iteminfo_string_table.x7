	<string key="T1031203" kor="바다의 향기가 물씬 풍기는 바다소녀 스커트" cns="散发着浓浓海水气息的爱心舵手裙子"/>
	<string key="N1041203" kor="파이로트 하트 브레슬렛" cns="爱心舵手手镯"/>
