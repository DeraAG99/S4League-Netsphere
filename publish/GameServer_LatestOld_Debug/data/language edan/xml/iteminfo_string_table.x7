	<string key="N4052927" kor="코튼 캣 보이 블루 세트" ger="Cotton Cat Boy Blue Set" eng="Cotton Cat Boy Blue Set" tur="Cotton Cat Boy Blue Set" fre="Cotton Cat Boy Blue Set" rus="Cotton Cat Boy Blue Set"/>
	<string key="N4052928" kor="코튼 캣 보이 블랙 세트" ger="Cotton Cat Boy Black Set" eng="Cotton Cat Boy Black Set" tur="Cotton Cat Boy Black Set" fre="Cotton Cat Boy Black Set" rus="Cotton Cat Boy Black Set"/>
	<string key="N4052929" kor="코튼 캣 보이 그린 세트" ger="Cotton Cat Boy Green Set" eng="Cotton Cat Boy Green Set" tur="Cotton Cat Boy Green Set" fre="Cotton Cat Boy Green Set" rus="Cotton Cat Boy Green Set"/>
	<string key="N4052930" kor="코튼 캣 보이 옐로우 세트" ger="Cotton Cat Boy Yellow Set" eng="Cotton Cat Boy Yellow Set" tur="Cotton Cat Boy Yellow Set" fre="Cotton Cat Boy Yellow Set" rus="Cotton Cat Boy Yellow Set"/>
