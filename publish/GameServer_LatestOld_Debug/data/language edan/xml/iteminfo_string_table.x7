	<string key="N4052924" kor="사이버틱 걸 세트" ger="Cyber Girl Set" eng="Cyber Girl Set" tur="Cyber Girl Set" fre="Cyber Girl Set" rus="Cyber Girl Set"/>
	<string key="N4052925" kor="스타디움 걸 세트" ger="Stadium Girl Set" eng="Stadium Girl Set" tur="Stadium Girl Set" fre="Stadium Girl Set" rus="Stadium Girl Set"/>
