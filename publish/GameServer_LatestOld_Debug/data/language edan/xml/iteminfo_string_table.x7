	<string key="N1021120" kor="남자 기본체형 상체" cns="男子基本体型上衣"/>
	<string key="T1021120" kor="두근두근 이두 삼두를 펜끝에서 피워낸 진성씨의 혼이 담긴 남자 기본체형 상체" cns="扑通扑通，在笔尖展现的肱二头肌、肱三头肌，装有真性魂魄的男子基本体型上衣"/>
	<string key="N1021121" kor="여자 기본체형 상체" cns="女子基本体型上衣"/>
	<string key="T1021121" kor="두근두근 부끄럽게 펜끝에서 피워낸 진성씨의 젊음이 담긴 여자 기본체형 상체" cns="扑通扑通，在笔尖展现的真性年轻的女子基本体型上衣"/>
	<string key="N1031120" kor="남자 기본체형 하체" cns="男子基本体型裤子"/>
	<string key="T1031120" kor="울끈불끈 허벅근육을 펜끝에서 피워낸 진성씨의 혼이 담긴 남자 기본체형 하체" cns="大腿内侧肌肉,在笔尖展现的真性魂魄的男子基本体型裤子"/>
	<string key="N1031121" kor="여자 기본체형 상체" cns="女子基本体型上衣"/>
	<string key="T1031121" kor="구글구글 부끄럽게 펜끝에서 피워낸 진성씨의 젊음이 담긴 여자 기본체형 하체" cns="展现出真实的年轻女子基本体型的裤子"/>
	<string key="N1041120" kor="남자 기본체형 손" cns="男子基本体型手"/>
	<string key="T1041120" kor="엄지 검지외에 세 손가락이 붙어버린 슬픈 남자의 손" cns="除了拇指、食指其他三个手指黏在一起的悲伤男子的手"/>
	<string key="N1041121" kor="여자 기본체형 손" cns="女子基本体型手"/>
	<string key="T1041121" kor="엄지 검지외에 세 손가락이 붙어버린 예쁜 여자의 손" cns="除了拇指、食指其他三个手指黏在一起的美丽女子的手"/>
	<string key="N1051120" kor="남자 기본체형 발" cns="男子基本体型脚"/>
	<string key="T1051120" kor="발바닥에 발가락을 표현하지 않으면 버그로 돌아오고 마는 슬픈 유럽의 전설" cns="不在脚掌变现脚趾的话，会以变不回来的，悲伤欧洲的传说"/>
	<string key="N1051121" kor="여자 기본체형 발" cns="女子基本体型脚"/>
	<string key="T1051121" kor="발바닥에 발가락을 그려넣지 않으면, 무좀이라 우겨봐도 버그로 잡혀오는 슬픈 유럽의 전설" cns="不在脚掌画出脚趾的话,即使固执地辩解是脚气,也会以被抓回来的，悲伤欧洲的传说"/>
	<string key="N4035300" kor="아마존 워리어 복장 캡슐" ger="Amazon Warrior Set Capsule" eng="Amazon Warrior Set Capsule" tur="Amazon Warrior Set Capsule" fre="Amazon Warrior Set Capsule" spa="Amazon Warrior Set Capsule" ita="Amazon Warrior Set Capsule" rus="Amazon Warrior Set Capsule" ame="Amazon Warrior Set Capsule" cns="亚马逊战士套装扭蛋" tha="Amazon Warrior Set Capsule" twn="Amazon Warrior Set Capsule" jap="Amazon Warrior Set Capsule" idn="Amazon Warrior Set Capsule"/>
	<string key="T4035300" kor="아마존 워리어 세트를 얻을 수 있는 캡슐입니다.{N}캡슐 아이템 사용시 다음과 같은 아이템이 랜덤하게 지급됩니다." ger="Amazon Warrior Set.{N}Benutze diese Capsule, um folgende Zufallsitems zu erhalten:" eng="Amazon Warrior Set.{N}Use this capsule and you will receive the following items randomly." tur="Amazon Warrior Set.{N}Bu capsule'yi kullanın, aşağıdaki eşyaları rasgele alacaksınız." fre="La panoplie complète de la Reine Amazone.{N}Ouvrez cette Capsule pour recevoir les objets suivants au hasard." spa="Amazon Warrior Set.{N}Usando esta cápsula recibirás los siguientes artículos al azar." ita="Amazon Warrior Set.{N}Usa questa capsule e riceverai gli oggetti seguenti in maniera casuale." rus="Amazon Warrior Set.{N}Используй эту капсулу, чтобы получить следующие случайные предметы." ame="Amazon Warrior Set.{N}Use this capsule and you will receive the following items randomly." cns="可以获得亚马逊战士套装的扭蛋{N}使用扭蛋时，可随机获得下列道具" tha="Amazon Warrior Set.{N}Use this capsule and you will receive the following items randomly." twn="Amazon Warrior Set.{N}Use this capsule and you will receive the following items randomly." jap="Amazon Warrior Set.{N}Use this capsule and you will receive the following items randomly."/>
