	<string key="N1051203" kor="파이로트 하트 슈즈" cns="爱心舵手鞋"/>
	<string key="T1051203" kor="바다의 향기가 물씬 풍기는 바다소녀 신발" cns="散发着浓浓海水气息的爱心舵手鞋子"/>
