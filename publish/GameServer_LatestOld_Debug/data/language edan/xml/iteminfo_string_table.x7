	<string key="T4051979" kor="블러디 헌터 세트입니다. {N}세트 아이템 사용시 다음과 같은 아이템이 지급됩니다." ger="Bloody Hunter Set. {N} Enthält folgende Items:" eng="Bloody Hunter Set. {N}Set contains the following items:" tur="Bloody Hunter Set. {N}Set şu nesneleri içerir:" fre="Bloody Hunter Set. {N}Le set contient l'un des objets suivants :" rus="Bloody Hunter Set. {N}В набор входят предметы:" cns="赤焰猎手（男）套装{N}使用套装时，可随机获得下列道具"/>
	<string key="N4051980" kor="블러디 헌터 세트 (내구제)" ger="Bloody Hunter Set (Permanent)" eng="Bloody Hunter Set (Permanent)" tur="Bloody Hunter Set (Permanent)" fre="Bloody Hunter Set (Permanent)" rus="Bloody Hunter Set (Бессрочн.)" cns="赤焰猎手（男）套装（永久）"/>
	<string key="T4051980" kor="블러디 헌터 세트입니다. {N}세트 아이템 사용시 다음과 같은 아이템이 지급됩니다." ger="Bloody Hunter Set. {N} Enthält folgende Items:" eng="Bloody Hunter Set. {N}Set contains the following items:" tur="Bloody Hunter Set. {N}Set şu nesneleri içerir:" fre="Bloody Hunter Set. {N}Le set contient l'un des objets suivants :" rus="Bloody Hunter Set. {N}В набор входят предметы:" cns="赤焰猎手（男）套装{N}使用套装时，可随机获得下列道具"/>
	<string key="N4051981" kor="블러디 헌트리스 세트 (1일)" ger="Bloody Huntress Set (1 Day)" eng="Bloody Huntress Set (1 Day)" tur="Bloody Huntress Set (1 Day)" fre="Bloody Huntress Set (1 Day)" rus="Bloody Huntress Set (1 день)" cns="赤焰猎手（女）套装（1日）"/>
