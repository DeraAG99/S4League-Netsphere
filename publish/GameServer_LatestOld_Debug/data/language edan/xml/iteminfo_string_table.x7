	<string key="T1021157" kor="태양과 같이 강렬하고 카리스마 있는 여성을 위한 라이더 슈트" cns="有着像太阳一样强烈魅力的女性骑手上衣"/>
	<string key="N1031157" kor="썬 라이더 팬츠" cns="太阳骑手裤子"/>
	<string key="T1031157" kor="태양과 같이 강렬하고 카리스마 있는 여성을 위한 라이더 팬츠" cns="有着像太阳一样强烈魅力的女性骑手裤子"/>
	<string key="N1041157" kor="썬 라이더 글러브" cns="太阳骑手手套"/>
	<string key="T1041157" kor="태양과 같이 강렬하고 카리스마 있는 여성을 위한 라이더 글러브" cns="有着像太阳一样强烈魅力的女性骑手手套"/>
	<string key="N1051157" kor="썬 라이더 슈즈" cns="太阳骑手鞋子"/>
	<string key="T1051157" kor="태양과 같이 강렬하고 카리스마 있는 여성을 위한 라이더 슈즈" cns="有着像太阳一样强烈魅力的女性骑手鞋子"/>
	<string key="N2000049" kor="스파이 대거" cns="战术匕首"/>
	<string key="T2000049" kor="강력한 근접 대미지와 기동력을 자랑하는 기습용 근접무기. 착용 시 캐릭터의 움직임이 더욱 빠르고 민첩해진다." cns="有着强大的近战伤害，赋予玩家更高的机动力。使用时，玩家的动作会变得更敏捷。"/>
	<string key="N2010046" kor="호밍 라이플" cns="追踪步枪"/>
	<string key="T2010046" kor="발사 시 탄착군을 보정하는 무기. 거리와 공격 시간이 길어질수록 보정 수치가 낮아진다." cns="射击时会自动修正弹道的武器。但攻击距离越远、攻击时间越长，修正准确率越低。"/>
	<string key="N2050011" kor="어스 봄버" cns="核爆手雷"/>
	<string key="T2050011" kor="탄의 추락과 동시에 주변의 에너지를 모으다가 임계점에 이르게 되면 이를 팽창시켜 강한 폭발을 일으키는 무기. 적군은 물론 아군과 자신에게까지 타격을 입히기 때문에 사용에 주의를 요한다." cns="将巨大的能量压缩成球形，极具破坏力的武器。无论是对敌人还是自己都具有巨大的破坏力，使用的时候要注意隐蔽哦！"/>
	<string key="N2000050" kor="엑소 사이드" cns="收割者"/>
	<string key="T2000050" kor="릴리트에 의해 바이러스로 감염된 넷 스피어에 새롭게 생겨난 근접 무기. 경량화 된 사이드로 상대에게 빠르게 접근할 수 있으며, 적을 공중으로 띄워 제압이 가능하다." cns="莉莉丝病毒感染极限战网后，艾斯波科技通过研究被感染的数据，发明了一种全新的武器。{N}持有该武器可以快速接近敌人，并把他们扔向空中后收割其生命。"/>
	<string key="N2010047" kor="서브 머신 건" cns="速射双枪"/>
	<string key="T2010047" kor="빠른 연사 속도와 무난한 집탄률로 중거리 공격에 적합한 무기." cns="可以快速射击的双枪，但是命中率一般，适合中距离攻击的武器。"/>
	<string key="N2040009" kor="센트리건" cns="机械炮台"/>
	<string key="T2040009" kor="전방의 적을 찾아 공격하는 설치형 무기. 설치한 방향을 기준으로 공격하며 설치한 방향 반대편은 공격하지 않는다." cns="可以自动寻找和攻击敌人的特殊武器，但只能攻击正前方的敌人。"/>
	<string key="N3000006" kor="체력 마스터리" cns="生命强化"/>
	<string key="T3000006" kor="별다른 입력 없이 착용만 하면 효력이 발생하는 패시브 스킬. 체력을 높여 생존 시간을 늘릴 수 있다." cns="被动技能。增加生命上限。"/>
	<string key="N3050003" kor="쉴드" cns="力场护盾"/>
	<string key="T3050003" kor="전방에 방어막을 생성. 상대방의 총기류 공격을 막으며 공격할 수 있다. 방어막 뒤쪽의 아군이 방어막을 관통해 지원 사격을 할 수 있다는 점이 특징. 단, 근거리 공격을 쓰면 해제된다." cns="在前方生成防护罩。阻挡对方的远程攻击。护盾后边的队友可以贯穿护盾进行射击。但是，使用近战攻击时，技能会被解除。"/>
	<string key="N1011149" kor="제스트 스타일" cns="橙皮风格"/>
	<string key="T1011149" kor="강한 열정과 흥미를 표출하는 스타일" cns="表现热情和兴趣的风格"/>
	<string key="N1011150" kor="피스트 스타일" cns="铁拳脸型"/>
	<string key="T1011150" kor="강력한 여성 파이터의 인상을 풍기는 얼굴" cns="坚强的女性拳击手的脸"/>
	<string key="N1061149" kor="어드밴스드 보이 고글" cns="未来少年护目镜"/>
	<string key="T1061149" kor="훈련에 적합하게 개조된 형태의 기본 고글" cns="充满了科幻感的未来少年护目镜"/>
	<string key="N1061150" kor="어드밴스드 걸 헤드폰" cns="未来少女耳机"/>
	<string key="T1061150" kor="훈련에 적합하게 개조된 형태의 기본 헤드폰" cns="充满了科幻感的未来少女耳机"/>
