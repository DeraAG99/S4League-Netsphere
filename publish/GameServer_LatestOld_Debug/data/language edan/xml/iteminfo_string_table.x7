	<string key="T1051109" kor="얼음처럼 차가운 영혼의 소유자 릴리트의 부츠" ger="Die Stiefel der herzlosen Lilith." eng="Die Stiefel der herzlosen Lilith." tur="Boots of Heartless Lilith" fre="Frozen Lilith'in bot" spa="Les bottes de Lilith la sans cœur." ita="Boots of Heartless Lilith" rus="Обувь бессердечной Lilith." ame="Обувь бессердечной Lilith." cns="于冰霜之中重生的复仇者，意图将所有敌人冰封在仇恨之中的冰霜莉莉丝靴子"/>
	<string key="N1061108" kor="스페셜 스카우터 M" ger="Scouter of Frost Leader" eng="The scouter of Frost Leader" tur="Scouter of Frost Leader" fre="Scouter of Frost Leader" spa="The scouter of Frost Leader" ita="The scouter of Frost Leader" rus="The scouter of Frost Leader" cns="特别童子军（男）"/>
	<string key="T1061108" kor="한눈에 상대의 전투력 꿰둟어 볼수있는 프로스트 리더의 스카우터" ger="Der berühmte Scouter, der die Kampfskills deines Gegners analysiert." eng="The famous scouter that checks out the combat skill of your opponent." tur="Rakibinizin savaş yeteneklerine göz atan ünlü Scouter." fre="Le célèbre Scouter qui permet de voir les compétences de votre adversaire." spa="El famoso scouter que pone a prueba las habilidades de combate de tu adversario." ita="Il celebre scouter che verifica le abilità di combattimento del tuo avversario." rus="Известный скаутер, оценивающий боевые умения противника." cns="一眼就能看见对方战斗力的冰霜领主的童子军"/>
	<string key="N1061109" kor="스페셜 스카우터 W" ger="Scouter of Frozen Lilith" eng="The scouter of Frozen Lilith" tur="Scouter of Frozen Lilith" fre="Scouter of Frozen Lilith" spa="The scouter of Frozen Lilith" ita="The scouter of Frozen Lilith" rus="The scouter of Frozen Lilith" cns="特别童子军（女）"/>
	<string key="T1061109" kor="한눈에 상대의 전투력 꿰둟어 볼수있는 릴리트의 스카우터" ger="Der berühmte Scouter, der die Kampfskills deines Gegners analysiert." eng="The famous scouter that checks out the combat skill of your opponent." tur="Rakibinizin savaş yeteneklerine göz atan ünlü Scouter." fre="Le célèbre Scouter qui permet de voir les compétences de votre adversaire." spa="El famoso scouter que pone a prueba las habilidades de combate de tu adversario." ita="Il celebre scouter che verifica le abilità di combattimento del tuo avversario." rus="Известный скаутер, оценивающий боевые умения противника." cns="一眼就能看见对方战斗力的莉莉丝的童子军"/>
	<string key="N1001108" kor="프로스트 리더 카리스마 헤어" ger="Hair of Frost Leader" eng="Hair of Frost Leader" tur="Hair of Frost Leader" fre="Hair of Frost Leader" spa="Hair of Frost Leader" ita="Hair of Frost Leader" rus="Hair of Frost Leader" cns="冰霜领主魅力发型"/>
	<string key="T1001108" kor="리더의 카리스마가 느껴지는 프로스트 리더의 헤어" ger="Diese Frisur macht dich mächtig-eisig-cool!" eng="The hair style that makes you mighty-frosty-cool!" tur="Yaramaz, seksi ve harika görünmenizi sağlayan bir saç stili." fre="Une coupe de cheveux qui vous donnera un air glacial !" spa="¡Un estilo de cabello que hace que te veas poderosamente helado!" ita="La pettinatura che ti rende congelato e fighissimo allo stesso tempo!" rus="Могущественная и леденяще классная прическа!" cns="散发领袖魅力的冰霜领主的发型"/>
	<string key="N1001109" kor="프로즌 릴리트 쇼트 헤어" ger="Short Hairstyle of Frozen Lilith" eng="hairstyle of Frozen Lilith" tur="hairstyle of Frozen Lilith" fre="hairstyle of Frozen Lilith" spa="hairstyle of Frozen Lilith" ita="hairstyle of Frozen Lilith" rus="hairstyle of Frozen Lilith" ame="hairstyle of Frozen Lilith" cns="冰霜莉莉丝发型" tha="hairstyle of Frozen Lilith" twn="hairstyle of Frozen Lilith" jap="hairstyle of Frozen Lilith"/>
	<string key="T1001109" kor="시크함이 묻어나는 프로즌 릴리트 헤어" ger="Diese Frisur macht dich mächtig-sexy-cool!" eng="The hair style that makes you mighty-sexy-cool!" tur="Yaramaz, seksi ve harika görünmenizi sağlayan bir saç stili." fre="Une coupe de cheveux qui vous donnera un air sexy !" spa="¡Un estilo de cabello que hace que te veas poderosamente atractivo!" ita="La pettinatura che ti rende ultra sensuale!" rus="Могущественная и леденяще сексуальная прическа!" cns="散发酷酷感觉的冰霜莉莉丝发型"/>
	<string key="N4035268" kor="프로스트 리더 세트 캡슐" ger="Frost Leader Set Capsule" eng="Frost Leader Set Capsule" tur="Frost Leader Set Capsule" fre="Frost Leader Set Capsule" spa="Frost Leader Set Capsule" ita="Frost Leader Set Capsule" rus="Frost Leader Set Capsule" cns="冰霜领主套装扭蛋"/>
	<string key="T4035268" kor="프로스트 리더 세트를 획득할 수 있는 캡슐입니다.{N}캡슐 아이템 사용시 다음과 같은 아이템이 랜덤하게 지급됩니다." ger="Enthält das Frost Leader Set.{N}Aus dieser Capsule erhältst du per Zufall eins der folgenden Items:" eng="Frost Leader Set can be acquired.{N}Use this Capsule item and you will receive some of the following items randomly." tur="Frost Leader Set edinilebilir. {N} Bu Capsule eşyayı kullanın ve aşağıdaki bazı rastgele eşyalardan elde edin." fre="Permet d'obtenir la tenue de Frost Leader.{N}En ouvrant cette Capsules, vous pouvez obtenir les objets ci-dessous." spa="El Frost Leader Set puede ser adquirido.{N}Usa esta Capsule y recibirás algunos de los siguientes artículos al azar:" ita="Il Frost Leader Set può essere ottenuto.{N}Utilizza questa Capsule e riceverai alcuni dei seguenti oggetti in maniera casuale." rus="Можно выиграть Frost Leader Set.{N}Используй эту капсулу, чтобы получить следующие случайные предметы." cns="可以获得冰霜领主套装的扭蛋{N}使用扭蛋时，可随机获得下列道具"/>
	<string key="N4035269" kor="프로즌 릴리트 세트 캡슐" ger="Frozen Lilith Set Capsule" eng="Frozen Lilith Set capsule" tur="Frozen Lilith Set Capsule" fre="Frozen Lilith Set Capsule" spa="Frozen Lilith Set capsule" ita="Frozen Lilith Set capsule" rus="Frozen Lilith Set capsule" cns="冰霜莉莉丝套装扭蛋"/>
	<string key="T4035269" kor="프로즌 릴리트 세트를 획득할 수 있는 캡슐입니다.{N}캡슐 아이템 사용시 다음과 같은 아이템이 랜덤하게 지급됩니다." ger="Enthält das Frozen Lilith Set.{N}Aus dieser Capsule erhältst du per Zufall eins der folgenden Items:" eng="Frozen Lilith Set can be acquired.{N}Use this Capsule item and you will receive some of the following items randomly." tur="Frozen Lilith Set edinilebilir. {N} Bu Capsule eşyayı kullanın ve aşağıdaki bazı rastgele eşyalardan elde edin." fre="Permet d'obtenir la tenue de Frozen Lilith.{N}En ouvrant cette Capsules, vous pouvez obtenir les objets ci-dessous." spa="El Frozen Lilith Set puede ser adquirido.{N}Usa esta Capsule y recibirás algunos de los siguientes artículos al azar:" ita="Il Frozen Lilith Set può essere ottenuto.{N}Utilizza questa Capsule e riceverai alcuni dei seguenti oggetti in maniera casuale." rus="Можно выиграть Frozen Lilith Set.{N}Используй эту капсулу, чтобы получить следующие случайные предметы." cns="可以获得冰霜莉莉丝套装的扭蛋{N}使用扭蛋时，可随机获得下列道具"/>
	<string key="N4051352" kor="프로스트 리더 세트(1일)" ger="Frost Leader Set (1 Tag)" eng="Frost Leader Set (1 Day)" tur="Frost Leader Set (1 Day)" fre="Frost Leader Set (1 Day)" spa="Frost Leader Set (1 Day)" ita="Frost Leader Set (1 Day)" rus="Frost Leader Set (1 день)" cns="冰霜领主套装（1日）"/>
