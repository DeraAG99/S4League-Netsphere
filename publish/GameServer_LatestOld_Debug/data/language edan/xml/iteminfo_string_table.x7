	<string key="N1021127" kor="샤크 프로텍터 탑" ger="Shark Savior Top" eng="Shark Savior Top" tur="Shark Savior Top" fre="Shark Savior Top" rus="Shark Savior Top" cns="鲨鱼守护者上衣"/>
	<string key="N1031127" kor="샤크 프로텍터 팬츠" ger="Shark Savior Pant" eng="Shark Savior Pant" tur="Shark Savior Pant" fre="Shark Savior Pant" rus="Shark Savior Pant" cns="鲨鱼守护者裤子"/>
	<string key="N1041127" kor="샤크 프로텍터 브레이슬릿" ger="Shark Savior Bracelet" eng="Shark Savior Bracelet" tur="Shark Savior Bracelet" fre="Shark Savior Bracelet" rus="Shark Savior Bracelet" cns="鲨鱼守护者手镯"/>
	<string key="N1051127" kor="샤크 프로텍터 웨지힐" ger="Shark Savior Wedge Heel" eng="Shark Savior Wedge Heel" tur="Shark Savior Wedge Heel" fre="Shark Savior Wedge Heel" rus="Shark Savior Wedge Heel" cns="鲨鱼守护者坡跟鞋"/>
	<string key="N1001127" kor="샤크 프로텍터 업 헤어" ger="Shark Savior Updo Hair" eng="Shark Savior Updo Hair" tur="Shark Savior Updo Hair" fre="Shark Savior Updo Hair" rus="Shark Savior Updo Hair" cns="鲨鱼守护者发型"/>
	<string key="N1011126" kor="샤크 슬레이어 페이스" ger="Shark Slayer Face" eng="Shark Slayer Face" tur="Shark Slayer Face" fre="Shark Slayer Face" rus="Shark Slayer Face" cns="鲨鱼猎手脸型"/>
	<string key="T1011126" kor="포악한 상어를 사냥하는 샤크 슬레이어의 얼굴. 그의 기세만으로 상어는 함부로 쳐들어오지 못한다고 합니다." ger="Das Gesicht des Shark Slayer, dem Killer brutaler Haie. Allein seine Anwesenheit hält Haie in sicherer Distanz." eng="Face of the Shark Slayer, killer of vicious sharks. His mere presence prevents the sharks from coming too near." tur="Vahşi köpek balıklarının katili Shark Slayer'ın yüzü. Varlığı köpek balıklarının çok fazla yakına gelmesine engel oluyor." fre="Visage de Shark Slayer, tueur de vils requins. Sa simple présence dissuade les requins de trop se rapprocher." rus="Лицо Shark Slayer, убийцы злобных акул. Только одно его присутствие представляет большую опасность для акул." cns="以捕猎鲨鱼为生的鲨鱼猎手脸型，光凭他的气势就能吓退鲨鱼。"/>
	<string key="N1011127" kor="샤크 프로텍터 페이스" ger="Shark Savior Face" eng="Shark Savior Face" tur="Shark Saviour Face" fre="Shark Savior Face" rus="Shark Savior Face" cns="鲨鱼守护者脸型"/>
	<string key="T1011127" kor="상어를 지키는 수호 여신 샤크 프로텍터의 얼굴. 포악한 상어지만 그녀 앞에서는 순한 동물이 된다고 합니다." ger="Das Gesicht des Shark Saviour, der Göttin aller Haie. In ihrer Nähe werden wilde Haie zu den sanftesten Lämmchen." eng="Face of the Shark Savior Goddess. In front of her, the vicious sharks are as gentle as lambs." tur="Shark Savior Goddess'ın yüzü. Onun karşısında vahşi köpek balıkları kuzu gibi oluyorlar." fre="Visage de la déesse Shark Savior. Les vils requins sont doux comme des agneaux en sa présence." rus="Лицо Shark Savior, богини-защитницы. В ее присутствии злобные акулы становятся милыми ягнятами." cns="立志守护鲨鱼免受屠戮的鲨鱼守护者脸型，残暴的鲨鱼在她面前却变得十分温顺。"/>
	<string key="T1021122" kor="진 오필리아를 만들어낸 해커 G의 개량 복장. 남성 리거들이 착용할 수 있도록 개량한 자켓" ger="Modifiziertes Kostüm für Dark Baron von Hacker G. Männerjacke für S4 Leaguer." eng="Modified Costume made for Dark Baron by Hacker G. Men's Jacket for S4 Leaguers." tur="Dark Baron için Hacker G. tarafından yapılmış modifiye kostüm. S4 League oyuncuları için Modifiye Erkek Ceketi." fre="Costume conçu pour Dark Baron modifié par Hacker G. Veste (H) modifiée pour les S4 Leaguers." rus="Модифицированный костюм для Dark Baron от Hacker G. Мужская куртка для S4 League игроков." cns="不论想法还是身世，都深深隐匿于黑暗之中，让人摸不清看不透的黑暗男爵夹克。"/>
	<string key="T1031122" kor="진 오필리아를 만들어낸 해커 G의 개량 복장. 남성 리거들이 착용할 수 있도록 개량한 팬츠" ger="Modifiziertes Kostüm für Dark Baron von Hacker G. Männerhose für S4 Leaguer." eng="Modified Costume made for Dark Baron by Hacker G. Men's Pants for S4 Leaguers." tur="Dark Baron için Hacker G. tarafından yapılmış modifiye kostüm. S4 League oyuncuları için Modifiye Erkek Pantolonu." fre="Costume conçu pour Dark Baron modifié par Hacker G. Pantalon (H) modifié pour les S4 Leaguers." rus="Модифицированный костюм для Dark Baron от Hacker G. Мужские брюки для S4 League игроков." cns="不论想法还是身世，都深深隐匿于黑暗之中，让人摸不清看不透的黑暗男爵裤子。"/>
	<string key="T1041122" kor="진 오필리아를 만들어낸 해커 G의 개량 복장. 남성 리거들이 착용할 수 있도록 개량한 글러브" ger="Modifiziertes Kostüm für Dark Baron von Hacker G. Männerhandschuhe für S4 Leaguer." eng="Modified Costume made for Dark Baron by Hacker G. Men's Gloves for S4 Leaguers." tur="Dark Baron için Hacker G. tarafından yapılmış modifiye kostüm. S4 League oyuncuları için Modifiye Erkek Eldivenleri." fre="Costume conçu pour Dark Baron modifié par Hacker G. Gants (H) modifiés pour les S4 Leaguers." rus="Модифицированный костюм для Dark Baron от Hacker G. Мужские перчатки для S4 League игроков." cns="不论想法还是身世，都深深隐匿于黑暗之中，让人摸不清看不透的黑暗男爵手套。"/>
	<string key="T1051122" kor="진 오필리아를 만들어낸 해커 G의 개량 복장. 남성 리거들이 착용할 수 있도록 개량한 워커" ger="Modifiziertes Kostüm für Dark Baron von Hacker G. Männerschuhe für S4 Leaguer." eng="Modified Costume made for Dark Baron by Hacker G. Men's Shoes for S4 Leaguers." tur="Dark Baron için Hacker G. tarafından yapılmış modifiye kostüm. S4 League oyuncuları için Modifiye Erkek Ayakkabıları." fre="Costume conçu pour Dark Baron modifié par Hacker G. Chaussures (H) modifiées pour les S4 Leaguers." rus="Модифицированный костюм для Dark Baron от Hacker G. Мужская обувь для S4 League игроков." cns="不论想法还是身世，都深深隐匿于黑暗之中，让人摸不清看不透的黑暗男爵鞋子。"/>
	<string key="T1001122" kor="진 오필리아의 컨셉을 따라 만든 남성용 헤어 스타일" ger="Men's Hairstyle for Dark Baron" eng="Men's Hairstyle for Dark Baron." tur="Dark Baron için Erkek Saçı" fre="Coiffure (H) pour Dark Baron." rus="Мужская прическа для Dark Baron." cns="不论想法还是身世，都深深隐匿于黑暗之中，让人摸不清看不透的黑暗男爵发型。"/>
	<string key="T1021123" kor="해커 G가 새롭게 부활 시킨 진 오필리아의 드레스. 폭주를 막기 위한 장치가 추가 되어 있다." ger="Jin Ophelias verbessertes Kleid von Hacker G. Ermöglicht bessere Kontrolle über den Charakter." eng="Improved Jin Ophelia's Dress by Hacker G. Allows increased control of the character." tur="Jin Ophelia için Hacker G. tarafından yapılmış gelişmiş kıyafet. Karakter kontolünde artış sağlar." fre="Robe de Jin Ophelia perfectionnée par Hacker G. Accroît la maniabilité du personnage." rus="Улучшенное платье Jin Ophelia от Hacker G. Позволяет лучше контролировать персонажа." cns="为了复仇，把善良出卖给黑暗的黑暗子爵礼服。"/>
	<string key="T1031123" kor="해커 G가 새롭게 부활 시킨 진 오필리아의 스커트. 폭주를 막기 위한 장치가 추가 되어 있다." ger="Jin Ophelias verbesserter Rock von Hacker G. Ermöglicht bessere Kontrolle über den Charakter." eng="Improved Jin Ophelia's Skirt by Hacker G. Allows increased control of the character." tur="Jin Ophelia için Hacker G. tarafından yapılmış gelişmiş etek. Karakter kontolünde artış sağlar." fre="Jupe de Jin Ophelia perfectionnée par Hacker G. Accroît la maniabilité du personnage." rus="Улучшенная юбка Jin Ophelia от Hacker G. Позволяет лучше контролировать персонажа." cns="为了复仇，把善良出卖给黑暗的黑暗子爵裙子。"/>
	<string key="T1041123" kor="해커 G가 새롭게 부활 시킨 진 오필리아의 글러브. 폭주를 막기 위한 장치가 추가 되어 있다." ger="Jin Ophelias verbesserte Handschuhe von Hacker G. Ermöglicht bessere Kontrolle über den Charakter." eng="Improved Jin Ophelia's Gloves by Hacker G. Allows increased control of the character." tur="Jin Ophelia için Hacker G. tarafından yapılmış gelişmiş eldivenler. Karakter kontolünde artış sağlar." fre="Gants de Jin Ophelia perfectionnés par Hacker G. Accroît la maniabilité du personnage." rus="Улучшенные перчатки Jin Ophelia от Hacker G. Позволяет лучше контролировать персонажа." cns="为了复仇，把善良出卖给黑暗的黑暗子爵手套。"/>
	<string key="T1051123" kor="해커 G가 새롭게 부활 시킨 진 오필리아의 슈즈. 폭주를 막기 위한 장치가 추가 되어 있다." ger="Jin Ophelias verbesserte Schuhe von Hacker G. Ermöglicht bessere Kontrolle über den Charakter." eng="Improved Jin Ophelia's Shoes by Hacker G. Allows increased control of the character." tur="Jin Ophelia için Hacker G. tarafından yapılmış gelişmiş ayakkabılar. Karakter kontolünde artış sağlar." fre="Chaussures de Jin Ophelia perfectionnées par Hacker G. Accroît la maniabilité du personnage." rus="Улучшенная обувь Jin Ophelia от Hacker G. Позволяет лучше контролировать персонажа." cns="为了复仇，把善良出卖给黑暗的黑暗子爵鞋子。"/>
	<string key="T1001123" kor="전투에 용이하도록 긴 머리를 리본으로 묶은 진 오필리아의 헤어. 폭주를 막기 위한 장치가 추가 되어 있다." ger="Jin Ophelia's Ponytail Ermöglicht bessere Kontrolle über den Charakter." eng="Jin Ophelia's Ponytail. Allows increased control of the character." tur="Jin Ophelia'nın At Kuyruğu. Karakter kontolünde artış sağlar." fre="Queue de cheval de Jin Ophelia. Accroît la maniabilité du personnage." rus="Конский хвост Jin Ophelia. Позволяет лучше контролировать персонажа." cns="为了复仇，把善良出卖给黑暗的黑暗子爵发型。"/>
	<string key="T1021126" kor="포악한 상어를 사냥하는 샤크 슬레이어의 탑. 그의 기세만으로 상어는 함부로 쳐들어오지 못한다고 합니다." ger="Diese Jacke gehört dem Shark Slayer, dem Killer brutaler Haie. Allein seine Anwesenheit hält Haie in sicherer Distanz." eng="A jacket belonging to the Shark Slayer, killer of vicious sharks. His mere presence prevents the sharks from coming too near." tur="Vahşi köpek balıklarının katili Shark Slayer'a ait bir ceket. Varlığı köpek balıklarının çok yakına gelmesine engel oluyor." fre="Une veste appartenant à Shark Slayer, tueur des vils requins. Sa simple présence dissuade les requins de trop se rapprocher." rus="Куртка, принадлежащая Shark Slayer, убийце злобных акул. Только одно его присутствие представляет большую опасность для акул." cns="以捕猎鲨鱼为生的鲨鱼猎手上衣，光凭他的气势就能吓退鲨鱼"/>
	<string key="T1031126" kor="포악한 상어를 사냥하는 샤크 슬레이어의 팬츠. 그의 기세만으로 상어는 함부로 쳐들어오지 못한다고 합니다." ger="Diese Hose gehört dem Shark Slayer, dem Killer brutaler Haie. Allein seine Anwesenheit hält Haie in sicherer Distanz." eng="Pants belonging to the Shark Slayer, killer of vicious sharks. His mere presence prevents the sharks from coming too near." tur="Vahşi köpek balıklarının katili Shark Slayer'a ait bir pantolon. Varlığı köpek balıklarının çok yakına gelmesine engel oluyor." fre="Pantalon appartenant à Shark Slayer, tueur de vils requins. Sa simple présence dissuade les requins de trop se rapprocher." rus="Штаны, принадлежащие Shark Slayer, убийце злобных акул. Только одно его присутствие представляет большую опасность для акул." cns="以捕猎鲨鱼为生的鲨鱼猎手裤子，光凭他的气势就能吓退鲨鱼"/>
	<string key="T1041126" kor="포악한 상어를 사냥하는 샤크 슬레이어의 브레이슬릿. 그의 기세만으로 상어는 함부로 쳐들어오지 못한다고 합니다." ger="Dieses Armband gehört dem Shark Slayer, dem Killer brutaler Haie. Allein seine Anwesenheit hält Haie in sicherer Distanz." eng="Bracelet belonging to the Shark Slayer, killer of vicious sharks. His mere presence prevents the sharks from coming too near." tur="Vahşi köpek balıklarının katili Shark Slayer'a ait bir bilezik. Varlığı köpek balıklarının çok yakına gelmesine engel oluyor." fre="Bracelet appartenant à Shark Slayer, tueur de vils requins. Sa simple présence dissuade les requins de trop se rapprocher." rus="Браслет, принадлежащий Shark Slayer, убийце злобных акул. Только одно его присутствие представляет большую опасность для акул." cns="以捕猎鲨鱼为生的鲨鱼猎手手镯，光凭他的气势就能吓退鲨鱼"/>
	<string key="T1051126" kor="포악한 상어를 사냥하는 샤크 슬레이어의 샌들. 그의 기세만으로 상어는 함부로 쳐들어오지 못한다고 합니다." ger="Diese Sandalen gehören dem Shark Slayer, dem Killer brutaler Haie. Allein seine Anwesenheit hält Haie in sicherer Distanz." eng="Sandal belonging to the Shark Slayer, killer of vicious sharks. His mere presence prevents the sharks from coming too near." tur="Vahşi köpek balıklarının katili Shark Slayer'a ait bir sandalet. Varlığı köpek balıklarının çok yakına gelmesine engel oluyor." fre="Sandales appartenant à Shark Slayer, tueur de vils requins. Sa simple présence dissuade les requins de trop se rapprocher." rus="Сандалии, принадлежащие Shark Slayer, убийце злобных акул. Только одно его присутствие представляет большую опасность для акул." cns="以捕猎鲨鱼为生的鲨鱼猎手凉鞋，光凭他的气势就能吓退鲨鱼"/>
	<string key="T1001126" kor="포악한 상어를 사냥하는 샤크 슬레이어의 헤어. 그의 기세만으로 상어는 함부로 쳐들어오지 못한다고 합니다." ger="Dieses Haar gehört dem Shark Slayer, dem Killer brutaler Haie. Allein seine Anwesenheit hält Haie in sicherer Distanz." eng="Hair of the Shark Slayer, killer of vicious sharks. His mere presence prevents the sharks from coming too near." tur="Vahşi köpek balıklarının katili Shark Slayer'ın saçı. Varlığı köpek balıklarının çok yakına gelmesine engel oluyor." fre="Chevelure de Shark Slayer, tueur de vils requins. Sa simple présence dissuade les requins de trop se rapprocher." rus="Прическа Shark Slayer, убийцы злобных акул. Только одно его присутствие представляет большую опасность для акул." cns="以捕猎鲨鱼为生的鲨鱼猎手发型，光凭他的气势就能吓退鲨鱼"/>
	<string key="T1021127" kor="상어를 지키는 수호 여신 샤크 프로텍터의 탑. 포악한 상어지만 그녀 앞에서는 순한 동물이 된다고 합니다." ger="Dieses Top gehört dem Shark Saviour, der Verteidigerin der Haie. In ihrer Nähe werden wilde Haie zu den sanftesten Lämmchen." eng="A top belonging to the Shark Savior,  defender of sharks. In front of her, the vicious sharks are as gentle as lambs." tur="Köpek balıklarının koruyucusu Shark Saviour'a ait eşya. Onun karşısında vahşi köpek balıkları kuzu gibi oluyorlar." fre="Haut appartenant à Shark Savior, protectrice des requins. Les vils requins sont doux comme des agneaux en sa présence." rus="Куртка, принадлежащая Shark Savior, защитнице акул. В ее присутствии злобные акулы становятся милыми ягнятами." cns="立志守护鲨鱼免受屠戮的鲨鱼守护者的上衣，残暴的鲨鱼在她面前却变得十分温顺。"/>
	<string key="T1031127" kor="상어를 지키는 수호 여신 샤크 프로텍터의 팬츠. 포악한 상어지만 그녀 앞에서는 순한 동물이 된다고 합니다." ger="Diese Hose gehört dem Shark Saviour, der Verteidigerin der Haie. In ihrer Nähe werden wilde Haie zu den sanftesten Lämmchen." eng="Pants belonging to the Shark Savior,  defender of sharks. In front of her, the vicious sharks are as gentle as lambs." tur="Köpek balıklarının koruyucusu Shark Saviour'a ait bir pantolon. Onun karşısında vahşi köpek balıkları kuzu gibi oluyorlar." fre="Pantalon appartenant à Shark Savior, protectrice des requins. Les vils requins sont doux comme des agneaux en sa présence." rus="Штаны, принадлежащие Shark Savior, защитнице акул. В ее присутствии злобные акулы становятся милыми ягнятами." cns="立志守护鲨鱼免受屠戮的鲨鱼守护者的裤子，残暴的鲨鱼在她面前却变得十分温顺。"/>
	<string key="T1041127" kor="상어를 지키는 수호 여신 샤크 프로텍터의 브레이슬릿. 포악한 상어지만 그녀 앞에서는 순한 동물이 된다고 합니다." ger="Dieses Armband gehört dem Shark Saviour, der Verteidigerin der Haie. In ihrer Nähe werden wilde Haie zu den sanftesten Lämmchen." eng="Bracelet belonging to the Shark Savior,  defender of sharks. In front of her, the vicious sharks are as gentle as lambs." tur="Köpek balıklarının koruyucusu Shark Saviour'a ait bir bilezik. Onun karşısında vahşi köpek balıkları kuzu gibi oluyorlar." fre="Bracelet appartenant à Shark Savior, protectrice des requins. Les vils requins sont doux comme des agneaux en sa présence." rus="Браслет, принадлежащий Shark Savior, защитнице акул. В ее присутствии злобные акулы становятся милыми ягнятами." cns="立志守护鲨鱼免受屠戮的鲨鱼守护者的手镯，残暴的鲨鱼在她面前却变得十分温顺。"/>
	<string key="T1051127" kor="상어를 지키는 수호 여신 샤크 프로텍터의 웨지힐. 포악한 상어지만 그녀 앞에서는 순한 동물이 된다고 합니다." ger="Diese Keilabsätze gehören dem Shark Saviour, der Verteidigerin der Haie. In ihrer Nähe werden wilde Haie zu den sanftesten Lämmchen." eng="Wedge Heels belonging to the Shark Savior,  defender of sharks. In front of her, the vicious sharks are as gentle as lambs." tur="Köpek balıklarının koruyucusu Shark Saviour'a ait çivili topuklar. Onun karşısında vahşi köpek balıkları kuzu gibi oluyorlar." fre="Compensées appartenant à Shark Savior, protectrice des requins. Les vils requins sont doux comme des agneaux en sa présence." rus="Танкетки, принадлежащие Shark Savior, защитнице акул. В ее присутствии злобные акулы становятся милыми ягнятами." cns="立志守护鲨鱼免受屠戮的鲨鱼守护者的坡跟鞋，残暴的鲨鱼在她面前却变得十分温顺。"/>
	<string key="T1001127" kor="상어를 지키는 수호 여신 샤크 프로텍터의 업 헤어. 포악한 상어지만 그녀 앞에서는 순한 동물이 된다고 합니다." ger="Diese Hochsteckfrisur gehört dem Shark Saviour, der Verteidigerin der Haie. In ihrer Nähe werden wilde Haie zu den sanftesten Lämmchen." eng="Updo Hair belonging to the Shark Savior,  defender of sharks. In front of her, the vicious sharks are as gentle as lambs." tur="Köpek balıklarının koruyucusu Shark Saviour'a ait topuz saç. Onun karşısında vahşi köpek balıkları kuzu gibi oluyorlar." fre="Cheveux relevés de Shark Savior, protectrice des requins. Les vils requins sont doux comme des agneaux en sa présence." rus="Высокая прическа Shark Savior, защитницы акул. В ее присутствии злобные акулы становятся милыми ягнятами." cns="立志守护鲨鱼免受屠戮的鲨鱼守护者的发型，残暴的鲨鱼在她面前却变得十分温顺。"/>
	<string key="N2000036" kor="데모닉 너클" ger="Demon's Fist" eng="Demon's Fist" tur="Demon's Fist" fre="Demon's Fist" rus="Demon's Fist" cns="红蜂臂铠"/>
	<string key="T2000036" kor="아이언 부츠 ? 정신사납긴 난 주먹을 자주 쓰지{N}-Hacker G-" ger="Eisenstiefel? Verteidigungswaffe?&#xA;Ich lasse meine Fäuste sprechen! &#xA;- Hacker G" eng="Iron boots? A Defensive weapons?{N}I'll speak with my fists!{N}- Hacker G-" tur="Demir botlar? Defansif silahlar?&#xA;Ben yumruklarımla konuşurum! &#xA;- Hacker G" fre="Des bottes en métal ? Des armes de défense ?&#xA;Je parle la langue des poings ! &#xA;- Hacker G" rus="Железные ботинки? Защитное оружие?{N}Я буду говорить своими кулаками!{N}- Hacker G -" cns="红蜂帝国研制的特典合金臂铠。{N}与浮空战靴一同开发的进攻武器。{N}但是使用过的人都说，浮空战靴不如合金臂铠来的好用。"/>
	<string key="N2040007" kor="오리진 에너지 서플라이" cns="起源能源供应"/>
	<string key="T2040007" kor="에너지 서플라이의 오리지날 버전. 에밀리가 고안한 장치. 최초에는 순수하게 아군의 치료를 목적으로 하였으나, 개발 중 공격 기능이 추가되었다." cns="能源供应的原版本。刺客信徒（女）研制出的设备。最初以治愈己方的目的来制作，但是在开发过程中添加了攻击功能。"/>
	<string key="N4020048" kor="아이템 조합 캡슐 - 최고급팩" cns="材料扭蛋-终极包"/>
	<string key="T4020048" kor="아이템 조합 재료 최고급팩 캡슐입니다.{N}캡슐 사용시 다음과 같은 아이템이 지급됩니다." cns="可以获得终极材料的扭蛋{N}使用扭蛋可随机获得下列道具"/>
	<string key="N4035313" kor="밀리터리 도미닉 - M 캡슐" ger="Military Dominic - M Capsule" eng="Military Dominic - M Capsule" tur="Military Dominic - M Capsule" fre="Military Dominic - M Capsule" spa="Military Dominic - M Capsule" ita="Military Dominic - M Capsule" rus="Military Dominic - M Capsule" cns="红蜂特战队（男）套装扭蛋"/>
