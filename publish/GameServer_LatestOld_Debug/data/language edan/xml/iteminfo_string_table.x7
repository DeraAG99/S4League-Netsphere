	<string key="T6010014" kor="G의 배트 래빗 캡슐을 통해서 지급되는 쿠폰 이벤트 쿠폰" ger="not trans" eng="not trans" tur="dönüş. yok" fre="not trans" spa="not trans" ita="not trans" rus="not trans" ame="not trans" cns="在“G的棒球兔扭蛋”中获得的活动兑换券" tha="not trans" twn="透過G的球棒兔膠囊所獲得的活動禮券" jap="【G】「バット・ラビット」カプセルから入手できるイベントクーポン" idn="Tidak bisa ditransaksikan"/>
	<string key="N1070014" kor="해피 래빗" ger="Happy Rabbit" eng="Happy Rabbit" tur="Happy Rabbit" fre="Happy Rabbit" spa="Happy Rabbit" ita="Happy Rabbit" rus="Happy Rabbit" ame="Happy Rabbit" cns="快乐兔" tha="Happy Rabbit" twn="開心兔" jap="ハッピーラビット" idn="Happy Rabbit"/>
	<string key="T1070014" kor="한복으로 곱게 치장한 토끼가 인사드려요~" ger="Ein aufgeweckter Hase, welcher einen traditionellen Koreanischen Hanbok trägt." eng="A chipper rabbit wearing a traditional Korean hanbok." tur="Yöresel Kore kıyafeti giyen şık bir tavşan." fre="Un lapin sauvage portant un hanbok, une tenue traditionnelle venant de Corée." spa="Happy Rabbit" ita="Happy Rabbit" rus="Жизнерадостный кролик, одетый в традиционный корейский ханбок." ame="Happy Rabbit" cns="据说带上这个兔子，一整天都会开心得不得了~" tha="มองเจ้ากระต่ายที่น่ารักตัวนี้ดูซิ! บางทีมันอาจจะทำให้คุณมีความสุขขึ้นมาได้นะ" twn="穿著美麗的韓服登場的兔子~" idn="Happy Rabbit"/>
	<string key="N1070013" kor="럭키 래빗" ger="Lucky Rabbit" eng="Lucky Rabbit" tur="Lucky Rabbit" fre="Lucky Rabbit" spa="Lucky Rabbit" ita="Lucky Rabbit" rus="Lucky Rabbit" ame="Lucky Rabbit" cns="幸运兔" tha="Lucky Rabbit" twn="幸運兔" jap="ラッキーラビット" idn="Lucky Rabbit"/>
	<string key="T1070013" kor="한복으로 듬직하게 차려입은 토끼가 인사드려요~" ger="Ein lebhafter adretter Hase in einem neuen Koreanischen Hanbok." eng="A most dapper rabbit decked out in a freshly-pressed Korean hanbok." tur="Yöresel yeni Kore kıyafetiyle süslenmiş zarif bir tavşan. " fre="Un lapin élégant affublé d’une tenue traditionnelle coréenne hanbok fraichement repassée. " spa="Lucky Rabbit" ita="Lucky Rabbit" rus="Кролик-денди, разодетый в новехонький корейский ханбок." ame="Lucky Rabbit" cns="据说带上这个兔子，会给你带来意想不到的好运气哦~" tha="มองเจ้ากระต่ายที่น่ารักตัวนี้ดูซิ! บางทีมันอาจจะทำให้คุณมีโชคดีได้นะ" twn="穿著韓服慎重登場的兔子~" idn="Lucky Rabbit"/>
