	<string key="N1051177" kor="엔비걸즈 부츠" ger="Envy Girls Boots" eng="Envy Girls Boots" tur="Envy Girls Boots" fre="Envy Girls Boots" rus="Envy Girls Boots" cns="假面超人（女）靴子"/>
