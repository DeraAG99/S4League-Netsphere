	<string key="N1061214" kor="진한 맛 맥주" ger="Rich Beer" eng="Rich Beer" tur="Rich Beer" fre="Rich Beer" rus="Rich Beer" cns="浓厚的啤酒"/>
	<string key="T1061214" kor="진한 맛 맥주통 (휴대용)" ger="Ein Bier mit milder aber vollmundiger Malznote." eng="A beer with a rich, wheat taste that smells of malt!" tur="Kendine has malt kokusunu hâlâ koruyan zengin tada sahip bir bira" fre="Une bière fruitée au caractère houblonné." rus="Пиво с богатым пшеничным вкусом, пахнущее солодом." cns="浓厚的啤酒（携带式）"/>
	<string key="N1061215" kor="시원한 맥주" ger="Fresh Beer" eng="Fresh Beer" tur="Fresh Beer" fre="Fresh Beer" rus="Fresh Beer" cns="清凉的啤酒"/>
	<string key="T1061215" kor="시원한 맥주통 (휴대용)" ger="Der frische, herbe Geschmack dieses Biers ist die perfekte Belohnung nach einem anstrengenden Tag." eng="A beer with a crisp, refreshing taste that melts the stress away!" tur="Taze tadıyla tüm stresinizi silip atabilecek bir bira" fre="Une bière rafraîchissante qui rappelle les belles journées d'été." rus="Пиво с освежающим вкусом, прогоняющим прочь всякие заботы." cns="清凉的啤酒（携带式）"/>
	<string key="N1061216" kor="찐한 맛 맥주" ger="Strong Beer" eng="Strong Beer" tur="Strong Beer" fre="Strong Beer" rus="Strong Beer" cns="浓厚的啤酒"/>
	<string key="T1061216" kor="찐한 맛 맥주통 (휴대용)" ger="Dieses Starkbier ist nichts für schwache Gemüter. Aber das Hopfenaroma ist einzigartig!" eng="A beer with a strong, hoppy taste that lingers in your mouth!" tur="Güçlü tadı ağzınızdan kolay kolay kaybolmayacak bir bira" fre="Une bière savoureuse dotée d'un arôme raffiné et d'un goût prononcé de malt." rus="Пиво с сильным хмельным вкусом, который долго остается во рту." cns="浓厚的啤酒（携带式）"/>
	<string key="N1061217" kor="깔끔한 맥주" ger="Smooth Beer" eng="Smooth Beer" tur="Smooth Beer" fre="Smooth Beer" rus="Smooth Beer" cns="纯净的啤酒"/>
	<string key="T1061217" kor="깔끔한 맥주통 (휴대용)" ger="Geradezu samtweich gleitet dieser Doppelbock deine Kehle hinunter." eng="A beer with a clean, cool taste that goes down smooth!" tur="İçimi güzel, ağızda hoş bir his bırakan bir bira" fre="Une bière dense, généreuse et ronde en bouche." rus="Пиво с чистым вкусом. Очень легко пьется." cns="纯净的啤酒（携带式）"/>
	<string key="N1061218" kor="작은 맥주 장식M" ger="Small Beer Decoration (M)" eng="Small Beer Decoration (M)" tur="Small Beer Decoration (M)" fre="Small Beer Decoration (M)" rus="Small Beer Decoration (M)" cns="小杯啤酒头饰"/>
	<string key="T1061218" kor="크으….취한다..." ger="Puh, das steigt einem ganz schön in den Kopf ..." eng="Another one down the hatch!" tur="Oyyy... Kafam güzel olmaya başladı..." fre="Encore une dans le gosier !" rus="А ну-ка еще по одной!" cns="在为期两周的慕尼黑啤酒节，每个参与者都在头上展示了这个头饰：它只是啤酒"/>
	<string key="N1061219" kor="작은 맥주 장식W" ger="Small Beer Decoration (F)" eng="Small Beer Decoration (F)" tur="Small Beer Decoration (F)" fre="Small Beer Decoration (F)" rus="Small Beer Decoration (F)" cns="小杯啤酒头饰"/>
	<string key="T1061219" kor="크으….취한다..." ger="Puh, das steigt einem ganz schön in den Kopf ..." eng="Another one down the hatch!" tur="Oyyy... Kafam güzel olmaya başladı..." fre="Encore une dans le gosier !" rus="А ну-ка еще по одной!" cns="在为期两周的慕尼黑啤酒节，每个参与者都在头上展示了这个头饰：它只是啤酒"/>
	<string key="N1061220" kor="크으은! 맥주 장식" ger="Gigantic Beer Decoration" eng="Gigantic Beer Decoration" tur="Gigantic Beer Decoration" fre="Gigantic Beer Decoration" rus="Gigantic Beer Decoration" cns="大杯啤酒头饰"/>
	<string key="T1061220" kor="크으아아아아…취한다~" ger="Hui, wieso wird mir so schwindelig ...?" eng="Bartender, pour me another!" tur="Oooooooyyyyy... Feci sarhoş oldum~" fre="Garçon ! Sers m'en un autre !" rus="Бармен, налей-ка еще!" cns="在为期两周的慕尼黑啤酒节，每个参与者都在头上展示了这个头饰：它只是啤酒"/>
	<string key="N4052345" kor="Trick or Treat BOX" ger="Trick or Treat!" eng="Trick or Treat!" tur="Trick or Treat!" fre="Trick or Treat!" rus="Trick or Treat!" cns="万圣节糖果盒子"/>
	<string key="T4052345" kor="Trick or Treat!{N}2016년 할로윈이 왔습니다.{N}다양한 선물들로 멋있고 이쁘게 분장해보세요!" ger="Süßes oder Saures!{N}Endlich ist wieder Halloween!{N}Schnapp dir tolle Preise und hübsch' dich auf!" eng="Trick or Treat!{N}It's finally Halloween in 2016!{N}Trick yourself out yourself with a variety of prizes!" tur="Şeker mi şaka mı?{N} Sonunda 2016 Cadılar Bayramı geldi! {N} Ödüllerden ödül beğenip kendini donat!" fre="Des bonbons ou un sort !{N}Halloween est enfin de retour.{N}Prenez le temps de renouveler votre garde-robe !" rus="Сладость или гадость!{N}Наконец-то Хэллоуин-2016!{N}Тебя ждут сладкие угощения и целая россыпь призов!" cns="不给糖就捣乱！{N}万圣节来临~{N}快打开看看有什么惊喜吧~"/>
	<string key="N2010056" kor="바르&amp;마르바스" ger="Barbas &amp; Marbas" eng="Barbas &amp; Marbas" tur="Barbas &amp; Marbas" fre="Barbas &amp; Marbas" rus="Barbas &amp; Marbas" cns="巴尔&amp;玛巴斯"/>
	<string key="T2010056" kor="사용자를 조금씩 악에 물들게 하는 저주받은 무기" ger="Eine Waffe, die den Besitzer allmählich ins Verderben stürzt. " eng="This powerful demonic weapon pulls its user deeper into damnation each time it is used." tur="Sahibini sürekli kötülüğe çeken bir silah." fre="Une arme qui imprègne peu à peu son propriétaire d'une énergie maléfique." rus="Мощное демоническое оружие проклинает владельца все сильнее с каждым использованием." cns="以七十二柱魔神命名的特典双持马格南。{N}拥有魔神的力量，也附上了魔神的诅咒。{N}使用者会渐渐被邪恶浸染的诅咒武器。"/>
	<string key="N4035477" kor="G의 바르&amp;마르바스 캡슐" ger="G's Barbas &amp; Marbas Capsule" eng="G's Barbas &amp; Marbas Capsule" tur="G's Barbas &amp; Marbas Capsule" fre="G's Barbas &amp; Marbas Capsule" rus="G's Barbas &amp; Marbas Capsule" cns="G的巴尔&amp;玛巴斯扭蛋"/>
	<string key="T4035477" kor="G의 바르&amp;마르바스 캡슐{N}캡슐 아이템 사용 시 다음과 같은 아이템이 랜덤하게 지급됩니다." ger="G's Barbas &amp; Marbas Capsule{N}Diese Kapsel kann folgende Items enthalten:" eng="G's Barbas &amp; Marbas Capsule{N}The capsule contains the following items at random:" tur="G's Barbas &amp; Marbas Capsule{N}Kapsül aşağıdaki eşyalardan birini rastgele verir:" fre="G's Barbas &amp; Marbas Capsule{N}Cette capsule contient aléatoirement les objets suivants :" rus="G's Barbas &amp; Marbas Capsule{N}Капсула содержит случайные предметы:" cns="可以获得巴尔&amp;玛巴斯的扭蛋{N}使用扭蛋时，，会随机赠送下列道具"/>
	<string key="N1021221" kor="플레어 가죽 자켓" ger="Iggy's Leather Jacket" eng="Iggy's Leather Jacket" tur="Iggy's Leather Jacket" fre="Iggy's Leather Jacket" rus="Iggy's Leather Jacket" cns="闪光之心皮夹克"/>
	<string key="T1021221" kor="가슴 속 타오르는 락 스피릿을 표현한 자켓" ger="Diese punkige Lederjacke ist der Inbegriff von Rock 'n' Roll." eng="A jacket imbued with the blazing soul of rock 'n roll." tur="Ateşli rock 'n roll ruhuyla kaplı bir ceket." fre="Enfilez cette veste pour devenir une icône du rock." rus="Куртка, полная огненного духа рок-н-ролла." cns="燃烧了摇滚之心的乐手爱穿的夹克"/>
	<string key="N1031221" kor="플레어 가죽 바지" ger="Iggy's Leather Pants" eng="Iggy's Leather Pants" tur="Iggy's Leather Jacket" fre="Iggy's Leather Pants" rus="Iggy's Leather Pants" cns="闪光之心皮裤"/>
	<string key="T1031221" kor="강렬한 락의 느낌을 살린 가죽 바지" ger="Robust und rockig, so muss eine Hose sein!" eng="A pair of pants imbued with the blazing soul of rock 'n roll." tur="Ateşli rock 'n roll ruhuyla kaplı bir pantolon" fre="Enfilez ce pantalon pour devenir une icône du rock." rus="Штаны, полные огненного духа рок-н-ролла." cns="燃烧了摇滚之心的乐手爱穿的皮裤"/>
	<string key="N1041221" kor="플레어 장갑" ger="Iggy's Gloves" eng="Iggy's Gloves" tur="Iggy's Gloves" fre="Iggy's Gloves" rus="Iggy's Gloves" cns="闪光之心手套"/>
	<string key="T1041221" kor="주체할 수 없는 락 스피릿이 잠들어 있는 장갑" ger="Die Handschuhe halten vielleicht nicht warm, sind aber ungemein stylisch!" eng="A pair of gloves imbued with the blazing soul of rock 'n roll." tur="Ateşli rock 'n roll ruhuyla kaplı bir çift eldiven." fre="Enfilez ces gants pour devenir une icône du rock." rus="Перчатки, полные огненного духа рок-н-ролла." cns="燃烧了摇滚之心的乐手爱戴的手套"/>
	<string key="N1051221" kor="플레어 신발" ger="Iggy's Shoes" eng="Iggy's Shoes" tur="Iggy's Shoes" fre="Iggy's Shoes" rus="Iggy's Shoes" cns="闪光之心鞋子"/>
	<string key="T1051221" kor="강렬한 락의 느낌을 가진 신발" ger="Derbe Stiefel, ein Muss für jeden Rocker." eng="A pair of boots imbued with the blazing soul of rock 'n roll." tur="Ateşli rock 'n roll ruhuyla kaplı bir çift bot." fre="Enfilez ces chaussures pour devenir une icône du rock." rus="Ботинки, полные огненного духа рок-н-ролла." cns="燃烧了摇滚之心的乐手爱穿的鞋子"/>
	<string key="N1001221" kor="플레어 투 블록" ger="Iggy's Rocker Hair" eng="Iggy's Rocker Hair" tur="Iggy's Rocker Hair" fre="Iggy's Rocker Hair" rus="Iggy's Rocker Hair" cns="闪光之心发型"/>
	<string key="T1001221" kor="강렬한 인상을 남기는 투 블록 스크레치 헤어" ger="Die Haare so ungestylt hinzustylen ist eine Kunst für sich!" eng="A cool hairstyle imbued with the blazing soul of rock 'n roll." tur="Ateşli rock 'n roll ruhuyla kaplı bir saç tarzı." fre="Grâce à cette coiffure élaborée, le public ne remarquera plus que vous dans la fosse !" rus="Крутая прическа, полная огненного духа рок-н-ролла." cns="燃烧了摇滚之心的乐手爱烫的头发"/>
	<string key="N1021222" kor="폴링 스타 자켓" ger="Stella's Jacket" eng="Stella's Jacket" tur="Stella's Jacket" fre="Stella's Jacket" rus="Stella's Jacket" cns="自由之星夹克"/>
	<string key="T1021222" kor="금방이라도 터질 듯한 락 스피릿을 표현한 자켓" ger="Diese punkige Lederjacke ist der Inbegriff von Rock 'n' Roll." eng="A jacket imbued with the heart and soul of rock 'n roll." tur="Rock 'n roll kalbi ve ruhuyla kaplı bir ceket." fre="Enfilez cette veste pour devenir une icône du rock." rus="Куртка, в которой живут сердце и душа рок-н-ролла." cns="高喊着“我会即兴说唱”的饶舌爱好者穿的夹克"/>
	<string key="N1031222" kor="폴링 스타 핫 팬츠" ger="Stella's Skirt" eng="Stella's Skirt" tur="Stella's Skirt" fre="Stella's Skirt" rus="Stella's Skirt" cns="自由之星超短裤"/>
	<string key="T1031222" kor="강렬한 락의 느낌을 살린 핫 팬츠" ger="Knapp und knackig, so müssen Röcke für Rockerladies sein!" eng="A skirt imbued with the heart and soul of rock 'n roll." tur="Rock 'n roll kalbi ve ruhuyla kaplı bir etek." fre="Enfilez cette jupe pour devenir une icône du rock." rus="Юбка, в которой живут сердце и душа рок-н-ролла." cns="高喊着“我会即兴说唱”的饶舌爱好者穿的超短裤"/>
	<string key="N1041222" kor="폴링 스타 링" ger="Stella's Ring" eng="Stella's Ring" tur="Stella's Ring" fre="Stella's Ring" rus="Stella's Ring" cns="自由之星戒指"/>
	<string key="T1041222" kor="적절한 포인트가 들어간 링" ger="Dieser Ring hat das Motto: Lieber klotzen als kleckern!" eng="A ring imbued with the heart and soul of rock 'n roll." tur="Rock 'n roll kalbi ve ruhuyla kaplı bir yüzük." fre="Enfilez cette bague pour devenir une icône du rock." rus="Кольцо, в котором живут сердце и душа рок-н-ролла." cns="高喊着“我会即兴说唱”的饶舌爱好者戴的戒指"/>
	<string key="N1051222" kor="폴링 스타 롱 부츠" ger="Stella's Long Boots" eng="Stella's Long Boots" tur="Stella's Long Boots" fre="Stella's Long Boots" rus="Stella's Long Boots" cns="自由之星长靴"/>
	<string key="T1051222" kor="강렬한 느낌을 주는 스파이크가 박힌 롱 부츠" ger="Hohe Stiefel für den besonderen Kick." eng="A pair of spiked long boots imbued with the heart and soul of rock 'n roll." tur="Rock 'n roll kalbi ve ruhuyla kaplı bir çift uzun, dikenli çizme." fre="Enfilez ces cuissardes à pointes pour devenir une icône du rock." rus="Длинные ботинки с шипами, в которых живут сердце и душа рок-н-ролла." cns="高喊着“我会即兴说唱”的饶舌爱好者穿的长靴"/>
	<string key="N1001222" kor="폴링 스타 포니테일" ger="Stella's Ponytail" eng="Stella's Ponytail" tur="Stella's Ponytail" fre="Stella's Ponytail" rus="Stella's Ponytail" cns="自由之星发型"/>
	<string key="T1001222" kor="강렬한 인상을 남기는 숏 컷 포니테일" ger="Der rockige Pferdeschwanz wippt im Takt der Gitarrenklänge." eng="A cool hairstyle imbued with the heart and soul of rock 'n roll." tur="Rock 'n roll kalbi ve ruhuyla kaplı bir saç tarzı." fre="Grâce à cette coiffure élaborée, le public ne remarquera plus que vous dans la fosse !" rus="Крутая прическа, в котором живут сердце и душа рок-н-ролла." cns="高喊着“我会即兴说唱”的饶舌爱好者发型"/>
