# editorconfig.org

# top-most EditorConfig file
root = true

# Default settings:
# A newline ending every file
# Use 4 spaces as indentation
[*]
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,cake}]
end_of_line = lf
trim_trailing_whitespace = true

[.gitlab-ci.yml]
end_of_line = lf
indent_size = 2
